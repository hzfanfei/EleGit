# 问象本机配置（复制为 .env 后填写。不要提交 .env，不要把 Secret 发到聊天或 PR）
# 完整说明见仓库根目录《配置说明.md》

# --- GitHub OAuth（浏览器登录）---
# 在 https://github.com/settings/developers 创建 OAuth App
# 回调填：{WENXIANG_PUBLIC_URL}/oauth/github/callback
GITHUB_CLIENT_ID=
GITHUB_CLIENT_SECRET=

# --- 公网地址（手机和 OAuth 回调都用这个）---
WENXIANG_PUBLIC_URL=https://nonstrategically-pulverable-libby.ngrok-free.dev

# --- 手机与本机共用的 API Key（自己设一串，两边相同）---
WENXIANG_API_KEY=

# --- 选仓后代码落盘目录（默认 ~/问象）---
# WENXIANG_WORKSPACE=

# --- 本机服务端口 ---
WENXIANG_PORT=8787

# --- 可选：Cursor ACP（本机已 agent login 则可空）---
# CURSOR_API_KEY=
# 问答模型，默认 composer-2.5
# WENXIANG_CURSOR_MODEL=composer-2.5

# --- 语音听写（按住说话）。优先火山；没有火山再填 OpenAI。不要提交真实密钥）---
# 全屏豆包式电话 WebSocket /v1/voice 默认关闭；仅调试时设为 true
WENXIANG_VOICE_CALL_ENABLED=false

# --- 通话 ASR/TTS 密钥（按住说话与旧电话共用）---
VOLC_APP_ID=
VOLC_ACCESS_TOKEN=
# 须与控制台小时版套餐一致：2.0 小时版常用 volc.seedasr.sauc.duration；未设置时代码默认 volc.bigasr.sauc.duration
# VOLC_ASR_RESOURCE_ID=volc.seedasr.sauc.duration
# VOLC_TTS_VOICE=zh_female_vv_uranus_bigtts
# VOLC_TTS_CLUSTER=volcano_tts
# VOLC_API_KEY=

# 没有火山密钥时：
# OPENAI_API_KEY=
# OPENAI_REALTIME_MODEL=gpt-4o-realtime-preview
# OPENAI_TTS_VOICE=alloy

